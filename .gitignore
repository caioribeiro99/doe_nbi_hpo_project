# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Envs
.venv/
.env
.vscode/*

# Jupyter
.ipynb_checkpoints/

# Outputs
experiments/*
runs/
*.log
catboost_info/
# Article-track cost calibration artifacts are versioned.
!experiments/_cost_calibration/
experiments/_cost_calibration/*
!experiments/_cost_calibration/*.json
!experiments/_cost_calibration/*.md
# Article-track smoke outputs are versioned (small JSON only).
!experiments/_v1_smoke/
experiments/_v1_smoke/*
!experiments/_v1_smoke/*.json
!experiments/_v1_smoke/*.md
# Article-track runtime profile artifacts.
!experiments/_runtime_profile/
experiments/_runtime_profile/*
!experiments/_runtime_profile/*.json
!experiments/_runtime_profile/*.md
# CC18 capability-audit artifacts (Commit 29).
!experiments/_capability_audit/
experiments/_capability_audit/*
!experiments/_capability_audit/*.json
!experiments/_capability_audit/*.md
# CC18 batch-run gate artifacts (Commit 32). Only the small JSON/MD
# headline files are committed; per-cell manifests, fold CSVs,
# fitted models, catboost_info, etc. stay untracked.
!experiments/_batch_runs/
experiments/_batch_runs/*
!experiments/_batch_runs/*.json
!experiments/_batch_runs/*.md

# Data (keep folder structure)
data/source/*
data/design/*
!data/source/.gitkeep
!data/source/README.md
!data/source/CHECKSUMS.txt
!data/source/AVAILABILITY_CHECK.md
!data/source/dataset_registry.json
# Per-dataset manifest.json is versioned; payloads stay ignored.
!data/source/*/
data/source/*/raw/
data/source/*/processed/
!data/source/*/manifest.json
!data/design/.gitkeep
!data/design/hyperparameter_design.csv
!data/design/hyperparameter_design.csv.metadata.json
!data/design/README.md

# macOS files
**/.DS_Store

