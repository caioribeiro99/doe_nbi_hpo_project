# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Envs
.venv/
.env
.vscode/*

# Jupyter
.ipynb_checkpoints/

# Outputs
experiments/*
# CC18 result handoff (Commit 35). The `runs/` tree holds local
# mutable execution state: copied .execution.sqlite shards, per-cell
# fold metrics, fitted models, and per-machine archives. Nothing
# under runs/ is ever committed; cross-machine handoff happens via
# the small JSON/MD summaries under experiments/_stage_runs/. See
# docs/RESULT_HANDOFF_PROTOCOL.md for the full contract.
runs/
runs/cc18/
*.log
catboost_info/
# Article-track cost calibration artifacts are versioned.
!experiments/_cost_calibration/
experiments/_cost_calibration/*
!experiments/_cost_calibration/*.json
!experiments/_cost_calibration/*.md
# Article-track smoke outputs are versioned (small JSON only).
!experiments/_v1_smoke/
experiments/_v1_smoke/*
!experiments/_v1_smoke/*.json
!experiments/_v1_smoke/*.md
# Article-track runtime profile artifacts.
!experiments/_runtime_profile/
experiments/_runtime_profile/*
!experiments/_runtime_profile/*.json
!experiments/_runtime_profile/*.md
# CC18 capability-audit artifacts (Commit 29).
!experiments/_capability_audit/
experiments/_capability_audit/*
!experiments/_capability_audit/*.json
!experiments/_capability_audit/*.md
# CC18 batch-run gate artifacts (Commit 32). Only the small JSON/MD
# headline files are committed; per-cell manifests, fold CSVs,
# fitted models, catboost_info, etc. stay untracked.
!experiments/_batch_runs/
experiments/_batch_runs/*
!experiments/_batch_runs/*.json
!experiments/_batch_runs/*.md
# CC18 stage-run summaries (Commit 35). Only the small JSON/MD files
# are committed: `_stage_runs/<run_id>_summary.{json,md}` ship the
# cross-machine handoff. Execution SQLite, fitted models, fold CSVs,
# catboost_info, and large logs stay under `runs/` and are never
# committed (see docs/RESULT_HANDOFF_PROTOCOL.md).
!experiments/_stage_runs/
experiments/_stage_runs/*
!experiments/_stage_runs/*.json
!experiments/_stage_runs/*.md

# Data (keep folder structure)
data/source/*
data/design/*
!data/source/.gitkeep
!data/source/README.md
!data/source/CHECKSUMS.txt
!data/source/AVAILABILITY_CHECK.md
!data/source/dataset_registry.json
# Per-dataset manifest.json is versioned; payloads stay ignored.
!data/source/*/
data/source/*/raw/
data/source/*/processed/
!data/source/*/manifest.json
# OpenML-CC18 raw-payload cache (Commit 34, batch_01).
# Per-task pickle payloads, per-task manifests, and the OpenML library
# cache subdirectory all stay gitignored on every machine. Do NOT
# commit anything under this tree; the gate artifact under
# experiments/_batch_runs/ records the SHA-256 of each payload so
# reproducibility is captured without shipping the raw bytes.
data/source/openml_cc18/
!data/design/.gitkeep
!data/design/hyperparameter_design.csv
!data/design/hyperparameter_design.csv.metadata.json
!data/design/README.md

# macOS files
**/.DS_Store

